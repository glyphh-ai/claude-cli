{
  "name": "claude",
  "kind": "cli",
  "description": "Claude Code, Anthropic's coding agent. Sign in once with cli_login (a claude.ai account, so its connectors come too), then run `-p <prompt>`.",
  "cli": {
    "install": { "image": "/usr/local/bin/claude" },
    "command": "claude",
    "allow": ["-p *", "--print *", "* -p *", "* --print *", "auth status*", "auth logout", "mcp list", "mcp get *", "--version", "--help"],
    "approvals": ["auth logout"],
    "env": { "DISABLE_AUTOUPDATER": "1", "ANTHROPIC_API_KEY": "secret?:ANTHROPIC_API_KEY" },
    "home": true,
    "login": { "args": ["auth", "login", "--claudeai"], "listen": true, "signed_in": ".claude/.credentials.json" }
  },
  "hosts": ["*.anthropic.com", "claude.ai", "*.claude.ai", "claude.com", "*.claude.com"],
  "secrets": ["ANTHROPIC_API_KEY"],
  "limits": { "seconds": 900, "memory_mb": 4096 }
}
